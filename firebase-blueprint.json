{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Registro de administrador autorizado no sistema QHS Engenharia.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "name", "createdAt"]
    },
    "AuthorizedEmail": {
      "title": "AuthorizedEmail",
      "description": "Índice O(1) de controle de acesso de colaboradores ativos por e-mail.",
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "isAdmin": {
          "type": "boolean"
        },
        "canDelete": {
          "type": "boolean"
        },
        "userDocId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["active", "isAdmin", "userDocId", "createdAt", "updatedAt"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Configurações institucionais e preferências visuais do almoxarifado QHS Engenharia.",
      "type": "object",
      "properties": {
        "showProductPhotos": {
          "type": "boolean"
        },
        "companyName": {
          "type": "string",
          "maxLength": 120
        },
        "companySubtitle": {
          "type": "string",
          "maxLength": 200
        },
        "cnpj": {
          "type": "string",
          "maxLength": 30
        },
        "contactEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "lowStockAlertNotification": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "showProductPhotos",
        "companyName",
        "companySubtitle",
        "cnpj",
        "contactEmail",
        "lowStockAlertNotification",
        "createdAt",
        "updatedAt"
      ]
    },
    "ManagedLists": {
      "title": "ManagedLists",
      "description": "Listas dinâmicas centralizadas (grupos de produtos, cargos e obras de destino).",
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "description": "Lista de grupos de produtos (ex: Materiais, Extintores, Placas)."
        },
        "roles": {
          "type": "array",
          "description": "Lista de cargos corporativos."
        },
        "destinations": {
          "type": "array",
          "description": "Lista de canteiros de obras e destinos."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["groups", "roles", "destinations", "createdAt", "updatedAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Perfil completo de colaborador com e-mail (PII restrita) e permissões individuais por aba.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "maxLength": 100
        },
        "isAdmin": {
          "type": "boolean"
        },
        "canDelete": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "permissions": {
          "type": "object",
          "description": "Permissões booleanas para as abas do aplicativo (incluindo colaboradores)."
        },
        "registrationDate": {
          "type": "string",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "role",
        "department",
        "isAdmin",
        "active",
        "permissions",
        "registrationDate",
        "createdAt",
        "updatedAt"
      ]
    },
