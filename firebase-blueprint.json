  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Administradores provisionados com acesso pleno."
    },
    "/authorizedEmails/{emailKey}": {
      "schema": { "$ref": "#/entities/AuthorizedEmail" },
      "description": "Mapeamento de e-mails autorizados (chave em minúsculas) para verificação rápida de permissão."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Configurações globais da empresa e exibição de fotos."
    },
    "/managedLists/{listId}": {
      "schema": { "$ref": "#/entities/ManagedLists" },
      "description": "Listas administradas de grupos, cargos e obras de destino."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Cadastro completo de colaboradores e suas permissões por aba (PII restrita)."
    },
    "/staffDirectory/{staffId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Diretório público interno (sem PII) de usuários cadastrados."
    },
    "/collaborators/{collaboratorId}": {
      "schema": { "$ref": "#/entities/Collaborator" },
      "description": "Cadastro exclusivo de colaboradores das obras (sem login) para seleção e histórico de retiradas."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Catálogo de materiais, extintores e placas do almoxarifado."
    },
    "/movements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Histórico imutável de entradas e saídas de estoque."
    },
    "/negativeRequests/{requestId}": {
      "schema": { "$ref": "#/entities/NegativeStockRequest" },
      "description": "Solicitações de saída com saldo negativo para análise do administrador."
    },
    "/deletionRequests/{requestId}": {
      "schema": { "$ref": "#/entities/DeletionRequest" },
      "description": "Solicitações de exclusão de registros aguardando aprovação do administrador."
    },
    "/deletionLogs/{logId}": {
      "schema": { "$ref": "#/entities/DeletionLog" },
      "description": "Histórico auditável de exclusões realizadas no sistema."
    }
  }
}
